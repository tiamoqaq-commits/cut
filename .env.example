# Copy to .env; process environment takes precedence.
CUT_PORT=8000
# CUT_DATA_DIR=/absolute/path/to/cut-data
CUT_MAX_UPLOAD_MB=200
CUT_STORAGE=local
CUT_PLANNER=rules
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# No cloud credentials required; future adapters document their own configuration.

# Chat Completions compatible API, base URL must include API prefix, not /chat/completions.
# No endpoint or model is assumed. Configure these in .env before using AI.
CUT_LLM_BASE_URL=
CUT_LLM_MODEL=
CUT_LLM_API_KEY=
CUT_LLM_TIMEOUT=90
# Enable only if your selected model supports response_format=json_object.
CUT_LLM_JSON_MODE=0
# Chinese subtitles need a Chinese font plus fontconfig and FFmpeg libass.
CUT_SUBTITLE_FONT=Noto Sans CJK SC
